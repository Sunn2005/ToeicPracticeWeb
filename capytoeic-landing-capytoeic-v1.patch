+            })
+            .catch((error) => {
+                if (cancelled) return;
+                setErrorMessage(error?.message || "");
+                setStatus("error");
+            });
+
+        return () => {
+            cancelled = true;
+        };
+    }, [reloadKey]);
+
+    const handleRetry = () => {
+        setErrorMessage("");
+        setStatus("loading");
+        setReloadKey((key) => key + 1);
+    };
+
+    if (status === "loading") {
+        return (
+            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="status" aria-label={t("landingTestsLoading")}>
+                {Array.from({ length: 3 }).map((_, index) => (
