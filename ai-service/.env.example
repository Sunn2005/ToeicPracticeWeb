# Copy this file to .env before running the AI service locally.

# Required: create a Gemini API key and keep it out of Git.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional: the application already defaults to this model.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=16384

# Required: Firebase Admin credentials used to read attempts/tests and write aiAnalyses.
FIREBASE_PROJECT_ID=toeicpractice-1445a
FIREBASE_SERVICE_ACCOUNT=file:/absolute/path/to/firebase-service-account.json

# Required: use the same RabbitMQ instance as the backend.
CLOUDAMQP_URL=amqp://guest:guest@localhost:5672

# Optional local override.
PORT=8081
AI_REVIEW_MAX_ATTEMPTS=3
AI_REVIEW_INITIAL_BACKOFF_MS=1000
AI_CHAT_HISTORY_MESSAGE_LIMIT=12
AI_CHAT_HISTORY_CHARACTER_LIMIT=12000
