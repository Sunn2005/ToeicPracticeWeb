# Copy this file to .env before running the backend locally.

# Required: use an absolute path to your local Firebase Admin service-account JSON.
FIREBASE_SERVICE_ACCOUNT=file:/absolute/path/to/firebase-service-account.json

# Required only for POST /api/employee/media.
FIREBASE_STORAGE_BUCKET=toeicpractice-1445a.firebasestorage.app

# Required: local RabbitMQ by default. Replace this with the CloudAMQP URL when needed.
CLOUDAMQP_URL=amqp://guest:guest@localhost:5672

# Optional local overrides.
PORT=8080
AI_TEST_ENDPOINT_ENABLED=false
AI_CHAT_DAILY_LIMIT=30
AI_CHAT_BURST_LIMIT=5
AI_CHAT_CONVERSATION_LIMIT=10
AI_CHAT_MESSAGE_CHARACTER_LIMIT=1000
AI_CHAT_HISTORY_MESSAGE_LIMIT=12
AI_CHAT_READ_LIMIT=100
IMPORT_TOEIC_DATA=false
TOEIC_DATA_RESOURCE=classpath:data/test-1-data.json
IMPORT_LISTENING_IMAGES=false
IMPORT_LISTENING_REVIEW_TEXT=false
